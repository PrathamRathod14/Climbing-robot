    <!-- ================================================================
         GECKOGRIP QUADRUPED — dynamic physics model with real gravity
         Body + 4 legs (upper+lower) joined via revolute joints.
         Gecko adhesive feet use a contact friction plugin to simulate
         dry-adhesion: high static friction holds the robot to the wall
         while gravity (0 0 -9.81) pulls it down.
         ================================================================ -->
    <model name="geckogrip_quadruped">
      <static>true</static>
      <pose>0 -0.28 1.35 0 0 0</pose>

      <!-- ── BODY ─────────────────────────────────────────────────── -->
      <link name="body">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <!-- 12 kg quadruped body, solid box approximation -->
          <mass>12.0</mass>
          <inertia>
            <ixx>0.1800</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.4600</iyy><iyz>0</iyz>
            <izz>0.5200</izz>
          </inertia>
        </inertial>
        <collision name="body_col">
          <geometry><box><size>0.58 0.28 0.78</size></box></geometry>
          <surface>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
            <contact><ode><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="base_link_0">
          <pose>0.000000 0.000000 0.000000 0.000000 -0.000000 0.000000</pose>
          <geometry>
            <mesh>
              <uri>file:///home/pratham/geckogrip_go2/dae/base.dae</uri>
              <scale>1.900000 1.900000 1.900000</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.48 0.52 0.55 1</ambient>
            <diffuse>0.48 0.52 0.55 1</diffuse>
            <specular>0.42 0.42 0.42 1</specular>
          </material>
        </visual>
        <visual name="front_camera_glow">
          <pose>0.56 0 0.08 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.055</radius>
            </sphere>
